peib:hasOpportunityStage a owl:ObjectProperty ; rdfs:domain peib:Opportunity ; rdfs:range skos:Concept ; rdfs:label "has opportunity stage" .
peib:hasMHRole         a owl:ObjectProperty ; rdfs:domain peib:BuyingCommittee ; rdfs:range skos:Concept ; rdfs:label "has Miller Heiman role" .
peib:hasDealType       a owl:ObjectProperty ; rdfs:domain peib:Deal ; rdfs:range skos:Concept ; rdfs:label "has deal type" .
peib:hasProductType    a owl:ObjectProperty ; rdfs:domain peib:Product ; rdfs:range skos:Concept ; rdfs:label "has product type" .
peib:hasCommitmentStatus a owl:ObjectProperty ; rdfs:domain peib:Commitment ; rdfs:range skos:Concept ; rdfs:label "has commitment status" .
peib:hasSentiment      a owl:ObjectProperty ; rdfs:domain peib:ClientHealthScore ; rdfs:range skos:Concept ; rdfs:label "has sentiment" .
peib:hasChurnRisk      a owl:ObjectProperty ; rdfs:domain peib:ClientHealthScore ; rdfs:range skos:Concept ; rdfs:label "has churn risk" .
peib:hasNPSSegment     a owl:ObjectProperty ; rdfs:domain peib:NPSSurvey ; rdfs:range skos:Concept ; rdfs:label "has NPS segment" .
peib:hasAlertType      a owl:ObjectProperty ; rdfs:domain peib:Alert ; rdfs:range skos:Concept ; rdfs:label "has alert type" .
peib:hasSeverity       a owl:ObjectProperty ; rdfs:domain peib:Alert ; rdfs:range skos:Concept ; rdfs:label "has severity" .
peib:hasInvestorType   a owl:ObjectProperty ; rdfs:domain peib:Prospect ; rdfs:range skos:Concept ; rdfs:label "has investor type" .
