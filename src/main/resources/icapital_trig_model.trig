        rdfs:comment "Amount for this call"@en ;
        rdfs:domain ic:Financial ;
        rdfs:range xsd:decimal .

    ic:targetSize a owl:DatatypeProperty ;
        rdfs:label "target size"@en ;
        rdfs:comment "Target fund size (USD)"@en ;
        rdfs:domain ic:Fund ;
        rdfs:range xsd:decimal .

    ic:targetsFund a owl:ObjectProperty ;
        rdfs:label "targets fund"@en ;
        rdfs:comment "Order targets a fund"@en ;
        rdfs:domain ic:Order ;
        rdfs:range ic:Fund .

    ic:timestamp a owl:DatatypeProperty ;
        rdfs:label "timestamp"@en ;
        rdfs:comment "Event timestamp (UTC, immutable)"@en ;
        rdfs:domain ic:AuditLog ;
        rdfs:range xsd:dateTime .

    ic:totalCommitment a owl:DatatypeProperty ;
        rdfs:label "total commitment"@en ;
        rdfs:comment "Total committed capital"@en ;
        rdfs:domain ic:Position ;
        rdfs:range xsd:decimal .

    ic:transactionDate a owl:DatatypeProperty,
            owl:FunctionalProperty ;
        rdfs:label "transaction date"@en ;
        rdfs:comment "Date transaction was submitted"@en ;
        rdfs:domain ic:Transaction ;
        rdfs:range xsd:date .

    ic:transactionId a owl:DatatypeProperty,
            owl:FunctionalProperty ;
        rdfs:label "transaction ID"@en ;
        rdfs:comment "Unique UUID for the transaction"@en ;
        rdfs:domain ic:Transaction ;
        rdfs:range xsd:string .

    ic:transactionStatus a owl:DatatypeProperty ;
        rdfs:label "transaction status"@en ;
        rdfs:comment "PENDING|APPROVED|FUNDED|REJECTED|CANCELLED"@en ;
        rdfs:domain ic:Transaction ;
        rdfs:range xsd:string .

    ic:transactionType a owl:DatatypeProperty ;
        rdfs:label "transaction type"@en ;
        rdfs:comment "SUBSCRIPTION|REDEMPTION|TRANSFER|DISTRIBUTION"@en ;
        rdfs:domain ic:Transaction ;
        rdfs:range xsd:string .

    ic:uncalledAmount a owl:DatatypeProperty ;
        rdfs:label "uncalled amount"@en ;
        rdfs:comment "Remaining unfunded commitment"@en ;
        rdfs:domain ic:Financial ;
        rdfs:range xsd:decimal .

    ic:unitsPurchased a owl:DatatypeProperty ;
        rdfs:label "units purchased"@en ;
        rdfs:comment "Units / shares acquired"@en ;
        rdfs:domain ic:Financial ;
        rdfs:range xsd:decimal .

    ic:unrealizedGain a owl:DatatypeProperty ;
        rdfs:label "unrealized gain"@en ;
        rdfs:comment "Unrealized gain or loss"@en ;
        rdfs:domain ic:Position ;
        rdfs:range xsd:decimal .

    ic:updatedAt a owl:DatatypeProperty ;
        rdfs:label "updated at"@en ;
        rdfs:comment "Last update timestamp (UTC)"@en ;
        rdfs:domain ic:TRIGEntity ;
        rdfs:range xsd:dateTime .

    ic:uploadDate a owl:DatatypeProperty ;
        rdfs:label "upload date"@en ;
        rdfs:comment "Date document was uploaded"@en ;
        rdfs:domain ic:Document ;
        rdfs:range xsd:date .

    ic:vintageYear a owl:DatatypeProperty ;
        rdfs:label "vintage year"@en ;
        rdfs:comment "Fund vintage year"@en ;
        rdfs:domain ic:Fund ;
        rdfs:range xsd:integer .

    ic:GovernanceDomain a owl:Class ;
        rdfs:label "Governance Domain"@en ;
        rdfs:comment "Entities in the Governance (G) TRIG domain"@en ;
        rdfs:subClassOf ic:TRIGEntity .

    ic:Custodian a owl:Class ;
        rdfs:label "Custodian"@en ;
        rdfs:comment "Financial institution that holds and safeguards assets"@en ;
        rdfs:subClassOf ic:RelationshipDomain .

    ic:InvestmentDomain a owl:Class ;
        rdfs:label "Investment Domain"@en ;
        rdfs:comment "Entities in the Investment (I) TRIG domain"@en ;
        rdfs:subClassOf ic:TRIGEntity .

    ic:RelationshipDomain a owl:Class ;
        rdfs:label "Relationship Domain"@en ;
        rdfs:comment "Entities in the Relationship (R) TRIG domain"@en ;
        rdfs:subClassOf ic:TRIGEntity .

    ic:TransactionDomain a owl:Class ;
        rdfs:label "Transaction Domain"@en ;
        rdfs:comment "Entities in the Transaction (T) TRIG domain"@en ;
        rdfs:subClassOf ic:TRIGEntity .

    ic:Order a owl:Class ;
        rdfs:label "Order"@en ;
        rdfs:comment "Subscription order linking investor, fund and account"@en ;
        rdfs:subClassOf ic:TransactionDomain .

    ic:ShareClass a owl:Class ;
        rdfs:label "Share Class"@en ;
        rdfs:comment "A specific share class within a fund with distinct terms"@en ;
        rdfs:subClassOf ic:InvestmentDomain .

    ic:FundManager a owl:Class ;
        rdfs:label "Fund Manager"@en ;
        rdfs:comment "General Partner (GP) entity that sponsors funds"@en ;
        rdfs:subClassOf ic:InvestmentDomain .

    ic:TRIGEntity a owl:Class ;
        rdfs:label "TRIG Entity"@en ;
        rdfs:comment "Abstract root class for all iCapital TRIG entities"@en .

    ic:Account a owl:Class ;
        rdfs:label "Account"@en ;
        rdfs:comment "Brokerage or custodial account belonging to an investor"@en ;
        rdfs:subClassOf ic:RelationshipDomain .

    ic:Advisor a owl:Class ;
        rdfs:label "Advisor"@en ;
        rdfs:comment "Registered Investment Advisor managing investor accounts"@en ;
        rdfs:subClassOf ic:RelationshipDomain .

    ic:Document a owl:Class ;
        rdfs:label "Document"@en ;
        rdfs:comment "Subscription agreement, PPM or compliance document"@en ;
        rdfs:subClassOf ic:GovernanceDomain .

    ic:CapitalCall a owl:Class ;
        rdfs:label "Capital Call"@en ;
        rdfs:comment "Individual capital call or distribution notice"@en ;
        rdfs:subClassOf ic:TransactionDomain .

    ic:KYC a owl:Class ;
        rdfs:label "KYC/AML Check"@en ;
        rdfs:comment "Know-Your-Customer and Anti-Money-Laundering compliance check"@en ;
        rdfs:subClassOf ic:GovernanceDomain .

    ic:AuditLog a owl:Class ;
        rdfs:label "Audit Log"@en ;
        rdfs:comment "Immutable change log entry for any TRIG entity"@en ;
        rdfs:subClassOf ic:GovernanceDomain .

    ic:Investor a owl:Class ;
        rdfs:label "Investor"@en ;
        rdfs:comment "Individual or entity that places subscriptions on iCapital"@en ;
        rdfs:subClassOf ic:RelationshipDomain .

    ic:Position a owl:Class ;
        rdfs:label "Position"@en ;
        rdfs:comment "Point-in-time snapshot of an investor account holding"@en ;
        rdfs:subClassOf ic:InvestmentDomain .

    ic:Transaction a owl:Class ;
        rdfs:label "Transaction"@en ;
        rdfs:comment "Core transaction header for subscriptions, redemptions, distributions and transfers"@en ;
        rdfs:subClassOf ic:TransactionDomain .

    ic:Financial a owl:Class ;
        rdfs:label "Financial"@en ;
        rdfs:comment "Monetary amounts and fee economics attached to a transaction"@en ;
        rdfs:subClassOf ic:TransactionDomain .

    ic:Fund a owl:Class ;
        rdfs:label "Fund"@en ;
        rdfs:comment "Private equity or alternatives fund on the iCapital platform"@en ;
        rdfs:subClassOf ic:InvestmentDomain .
}

