@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ic: <https://ontology.icapital.com/trig/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shx: <https://ontology.icapital.com/shapes/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://data.icapital.com/graph/governance> {
    <https://data.icapital.com/graph/governance> a owl:NamedIndividual ;
        rdfs:label "iCapital Governance Named Graph"@en ;
        dcterms:created "2024-01-01"^^xsd:date .

    <https://data.icapital.com/instance/auditlog/log-2024-001> a ic:AuditLog ;
        ic:action "STATUS_CHANGE" ;
        ic:auditOf <https://data.icapital.com/instance/transaction/txn-2024-00183741> ;
        ic:entityId "txn-2024-00183741" ;
        ic:entityType "Transaction" ;
        ic:ipAddress "10.0.1.42" ;
        ic:newValue "{\"status\":\"FUNDED\"}" ;
        ic:oldValue "{\"status\":\"APPROVED\"}" ;
        ic:performedBy "system:funding-engine" ;
        ic:timestamp "2024-04-01T09:00:00"^^xsd:dateTime .

    <https://data.icapital.com/instance/document/doc-sub-183741> a ic:Document ;
        ic:docType "SUBSCRIPTION_AGREEMENT" ;
        ic:fileName "Smith_Family_Trust_SubAgreement_ApolixIX_2024.pdf" ;
        ic:isExecuted true ;
        ic:signedDate "2024-03-15"^^xsd:date ;
        ic:storageUri "s3://icapital-docs/sub-agreements/doc-sub-183741.pdf"^^xsd:anyURI ;
        ic:uploadDate "2024-03-14"^^xsd:date .

    <https://data.icapital.com/instance/kyc/kyc-001122> a ic:KYC ;
        ic:checkDate "2024-03-10"^^xsd:date ;
        ic:kycCheckStatus "APPROVED" ;
        ic:pepFlag false ;
        ic:provider "LexisNexis" ;
        ic:reviewDate "2025-03-10"^^xsd:date ;
        ic:riskRating "LOW" ;
        ic:sanctionsFlag false .
}

<https://data.icapital.com/graph/ontology> {
    <https://data.icapital.com/graph/ontology> a owl:NamedIndividual ;
        rdfs:label "iCapital TRIG Ontology Graph"@en ;
        dcterms:created "2024-01-01"^^xsd:date .

    ic:accountNumber a owl:DatatypeProperty ;
        rdfs:label "account number"@en ;
        rdfs:comment "Custodian account number (masked)"@en ;
        rdfs:domain ic:Account ;
        rdfs:range xsd:string .

    ic:accountType a owl:DatatypeProperty ;
        rdfs:label "account type"@en ;
        rdfs:comment "INDIVIDUAL|JOINT|IRA_TRAD|IRA_ROTH|TRUST|CORPORATE"@en ;
        rdfs:domain ic:Account ;
        rdfs:range xsd:string .

    ic:accreditationStatus a owl:DatatypeProperty ;
        rdfs:label "accreditation status"@en ;
        rdfs:comment "ACCREDITED|QUALIFIED_PURCHASER|QUALIFIED_CLIENT"@en ;
        rdfs:domain ic:Investor ;
        rdfs:range xsd:string .

    ic:action a owl:DatatypeProperty ;
        rdfs:label "action"@en ;
        rdfs:comment "CREATE|UPDATE|DELETE|STATUS_CHANGE|APPROVE"@en ;
        rdfs:domain ic:AuditLog ;
        rdfs:range xsd:string .

    ic:advisedBy a owl:ObjectProperty ;
        rdfs:label "advised by"@en ;
        rdfs:comment "Investor advised by RIA"@en ;
        rdfs:domain ic:Investor ;
        rdfs:range ic:Advisor .

    ic:advisorName a owl:DatatypeProperty ;
        rdfs:label "advisor name"@en ;
        rdfs:comment "Advisor full name"@en ;
        rdfs:domain ic:Advisor ;
        rdfs:range xsd:string .

    ic:asOfDate a owl:DatatypeProperty ;
        rdfs:label "as-of date"@en ;
        rdfs:comment "Valuation date"@en ;
        rdfs:domain ic:Position ;
        rdfs:range xsd:date .

    ic:assetClass a owl:DatatypeProperty ;
        rdfs:label "asset class"@en ;
        rdfs:comment "PRIVATE_EQUITY|PRIVATE_CREDIT|REAL_ESTATE|HEDGE_FUND"@en ;
        rdfs:domain ic:Fund ;
        rdfs:range xsd:string .

    ic:auditOf a owl:ObjectProperty ;
        rdfs:label "audit of"@en ;
        rdfs:comment "Audit log entry for any entity"@en ;
        rdfs:domain ic:AuditLog ;
        rdfs:range ic:TRIGEntity .

    ic:aumUsd a owl:DatatypeProperty ;
        rdfs:label "AUM USD"@en ;
        rdfs:comment "Assets under management"@en ;
        rdfs:domain ic:FundManager ;
        rdfs:range xsd:decimal .

    ic:callAmount a owl:DatatypeProperty ;
        rdfs:label "call amount"@en ;
        rdfs:comment "Dollar amount of this call"@en ;
        rdfs:domain ic:CapitalCall ;
        rdfs:range xsd:decimal .

    ic:callDate a owl:DatatypeProperty ;
        rdfs:label "call date"@en ;
        rdfs:comment "Date notice was sent"@en ;
        rdfs:domain ic:CapitalCall ;
        rdfs:range xsd:date .

    ic:callNumber a owl:DatatypeProperty ;
        rdfs:label "call number"@en ;
        rdfs:comment "Sequential call number"@en ;
        rdfs:domain ic:CapitalCall ;
        rdfs:range xsd:integer .

    ic:callPercentage a owl:DatatypeProperty ;
        rdfs:label "call percentage"@en ;
        rdfs:comment "Percentage of total commitment called"@en ;
        rdfs:domain ic:CapitalCall ;
        rdfs:range xsd:decimal .

    ic:calledAmount a owl:DatatypeProperty ;
        rdfs:label "called amount"@en ;
        rdfs:comment "Capital called to date"@en ;
        rdfs:domain ic:Financial ;
        rdfs:range xsd:decimal .

    ic:calledPct a owl:DatatypeProperty ;
        rdfs:label "called pct"@en ;
        rdfs:comment "Percentage of commitment called"@en ;
        rdfs:domain ic:Position ;
        rdfs:range xsd:decimal .

    ic:carriedInterestPct a owl:DatatypeProperty ;
        rdfs:label "carried interest pct"@en ;
        rdfs:comment "Carried interest percentage"@en ;
        rdfs:domain ic:Financial ;
        rdfs:range xsd:decimal .

    ic:carryPct a owl:DatatypeProperty ;
        rdfs:label "carry pct"@en ;
        rdfs:comment "Carried interest percentage"@en ;
        rdfs:domain ic:Fund ;
        rdfs:range xsd:decimal .

    ic:checkDate a owl:DatatypeProperty ;
        rdfs:label "check date"@en ;
        rdfs:comment "Date KYC check was performed"@en ;
        rdfs:domain ic:KYC ;
        rdfs:range xsd:date .

    ic:className a owl:DatatypeProperty ;
        rdfs:label "class name"@en ;
        rdfs:comment "CLASS_A|CLASS_I|CLASS_S|CLASS_D"@en ;
        rdfs:domain ic:ShareClass ;
        rdfs:range xsd:string .

    ic:clearingCode a owl:DatatypeProperty ;
        rdfs:label "clearing code"@en ;
        rdfs:comment "ABA routing / clearing code"@en ;
        rdfs:domain ic:Custodian ;
        rdfs:range xsd:string .

    ic:commitmentAmount a owl:DatatypeProperty ;
        rdfs:label "commitment amount"@en ;
        rdfs:comment "Total committed capital"@en ;
        rdfs:domain ic:Financial ;
        rdfs:range xsd:decimal .

    ic:country a owl:DatatypeProperty ;
        rdfs:label "country"@en ;
        rdfs:comment "ISO 3166-1 alpha-2 country code"@en ;
        rdfs:domain ic:Investor ;
        rdfs:range xsd:string .

    ic:createdAt a owl:DatatypeProperty ;
        rdfs:label "created at"@en ;
        rdfs:comment "Record creation timestamp (UTC)"@en ;
        rdfs:domain ic:TRIGEntity ;
        rdfs:range xsd:dateTime .

    ic:currency a owl:DatatypeProperty ;
        rdfs:label "currency"@en ;
        rdfs:comment "ISO 4217 currency code"@en ;
        rdfs:domain ic:ShareClass ;
        rdfs:range xsd:string .

    ic:currentNav a owl:DatatypeProperty ;
        rdfs:label "current NAV"@en ;
        rdfs:comment "Current net asset value"@en ;
        rdfs:domain ic:Position ;
        rdfs:range xsd:decimal .

    ic:custodianName a owl:DatatypeProperty ;
        rdfs:label "custodian name"@en ;
        rdfs:comment "Institution name"@en ;
        rdfs:domain ic:Custodian ;
        rdfs:range xsd:string .

    ic:dateOfBirth a owl:DatatypeProperty ;
        rdfs:label "date of birth"@en ;
        rdfs:comment "DOB for individuals"@en ;
        rdfs:domain ic:Investor ;
        rdfs:range xsd:date .

    ic:distributionAmount a owl:DatatypeProperty ;
        rdfs:label "distribution amount"@en ;
        rdfs:comment "Distribution amount if any"@en ;
        rdfs:domain ic:Financial ;
        rdfs:range xsd:decimal .

    ic:distributionType a owl:DatatypeProperty ;
        rdfs:label "distribution type"@en ;
        rdfs:comment "RETURN_OF_CAPITAL|INCOME|GAIN|RECALLABLE"@en ;
        rdfs:domain ic:CapitalCall ;
        rdfs:range xsd:string .

    ic:distributionsRcvd a owl:DatatypeProperty ;
        rdfs:label "distributions received"@en ;
        rdfs:comment "Total distributions received"@en ;
        rdfs:domain ic:Position ;
        rdfs:range xsd:decimal .

    ic:docType a owl:DatatypeProperty ;
