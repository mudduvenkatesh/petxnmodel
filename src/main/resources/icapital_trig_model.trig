    ic:dtccId a owl:DatatypeProperty ;
        rdfs:label "DTCC ID"@en ;
        rdfs:comment "DTCC / DTC participant number"@en ;
        rdfs:domain ic:Custodian ;
        rdfs:range xsd:string .

    ic:dueDate a owl:DatatypeProperty ;
        rdfs:label "due date"@en ;
        rdfs:comment "Payment due date"@en ;
        rdfs:domain ic:CapitalCall ;
        rdfs:range xsd:date .

    ic:effectiveDate a owl:DatatypeProperty ;
        rdfs:label "effective date"@en ;
        rdfs:comment "Settlement / value date"@en ;
        rdfs:domain ic:Transaction ;
        rdfs:range xsd:date .

    ic:email a owl:DatatypeProperty ;
        rdfs:label "email"@en ;
        rdfs:comment "Primary business email"@en ;
        rdfs:domain ic:Advisor ;
        rdfs:range xsd:string .

    ic:entityId a owl:DatatypeProperty ;
        rdfs:label "entity ID"@en ;
        rdfs:comment "ID of the mutated entity"@en ;
        rdfs:domain ic:AuditLog ;
        rdfs:range xsd:string .

    ic:entityType a owl:DatatypeProperty ;
        rdfs:label "entity type"@en ;
        rdfs:comment "Type of mutated entity"@en ;
        rdfs:domain ic:AuditLog ;
        rdfs:range xsd:string .

    ic:fileName a owl:DatatypeProperty ;
        rdfs:label "file name"@en ;
        rdfs:comment "Original file name"@en ;
        rdfs:domain ic:Document ;
        rdfs:range xsd:string .

    ic:firmName a owl:DatatypeProperty ;
        rdfs:label "firm name"@en ;
        rdfs:comment "RIA / BD firm name"@en ;
        rdfs:domain ic:Advisor ;
        rdfs:range xsd:string .

    ic:foundedYear a owl:DatatypeProperty ;
        rdfs:label "founded year"@en ;
        rdfs:comment "Year firm was established"@en ;
        rdfs:domain ic:FundManager ;
        rdfs:range xsd:integer .

    ic:fundName a owl:DatatypeProperty ;
        rdfs:label "fund name"@en ;
        rdfs:comment "Full legal fund name"@en ;
        rdfs:domain ic:Fund ;
        rdfs:range xsd:string .

    ic:fundStatus a owl:DatatypeProperty ;
        rdfs:label "fund status"@en ;
        rdfs:comment "FUNDRAISING|INVESTING|HARVESTING|LIQUIDATED"@en ;
        rdfs:domain ic:Fund ;
        rdfs:range xsd:string .

    ic:fundTermYears a owl:DatatypeProperty ;
        rdfs:label "fund term years"@en ;
        rdfs:comment "Investment period in years"@en ;
        rdfs:domain ic:Fund ;
        rdfs:range xsd:integer .

    ic:fundType a owl:DatatypeProperty ;
        rdfs:label "fund type"@en ;
        rdfs:comment "BUYOUT|VENTURE|GROWTH|REAL_ASSETS|CREDIT|HEDGE_FUND"@en ;
        rdfs:domain ic:Fund ;
        rdfs:range xsd:string .

    ic:hardCap a owl:DatatypeProperty ;
        rdfs:label "hard cap"@en ;
        rdfs:comment "Hard cap on commitments"@en ;
        rdfs:domain ic:Fund ;
        rdfs:range xsd:decimal .

    ic:hasCapitalCall a owl:ObjectProperty ;
        rdfs:label "has capital call"@en ;
        rdfs:comment "Transaction has capital calls"@en ;
        rdfs:domain ic:Transaction ;
        rdfs:range ic:CapitalCall .

    ic:hasDocument a owl:ObjectProperty ;
        rdfs:label "has document"@en ;
        rdfs:comment "Transaction has document"@en ;
        rdfs:domain ic:Transaction ;
        rdfs:range ic:Document .

    ic:hasFinancial a owl:ObjectProperty ;
        rdfs:label "has financial"@en ;
        rdfs:comment "Transaction has financial record"@en ;
        rdfs:domain ic:Transaction ;
        rdfs:range ic:Financial ;
        owl:inverseOf ic:isFinancialOf .

    ic:hasKYC a owl:ObjectProperty ;
        rdfs:label "has KYC check"@en ;
        rdfs:comment "Investor has KYC/AML record"@en ;
        rdfs:domain ic:Investor ;
        rdfs:range ic:KYC .

    ic:hasOrder a owl:ObjectProperty ;
        rdfs:label "has order"@en ;
        rdfs:comment "Transaction is linked to an Order"@en ;
        rdfs:domain ic:Transaction ;
        rdfs:range ic:Order ;
        owl:inverseOf ic:isOrderOf .

    ic:hasShareClass a owl:ObjectProperty ;
        rdfs:label "has share class"@en ;
        rdfs:comment "Fund has share class"@en ;
        rdfs:domain ic:Fund ;
        rdfs:range ic:ShareClass ;
        owl:inverseOf ic:shareClassOf .

    ic:heldAt a owl:ObjectProperty ;
        rdfs:label "held at"@en ;
        rdfs:comment "Account held at custodian"@en ;
        rdfs:domain ic:Account ;
        rdfs:range ic:Custodian .

    ic:heldByAccount a owl:ObjectProperty ;
        rdfs:label "held by account"@en ;
        rdfs:comment "Position held in account"@en ;
        rdfs:domain ic:Position ;
        rdfs:range ic:Account .

    ic:holdsFund a owl:ObjectProperty ;
        rdfs:label "holds fund"@en ;
        rdfs:comment "Position is in this fund"@en ;
        rdfs:domain ic:Position ;
        rdfs:range ic:Fund .

    ic:hqLocation a owl:DatatypeProperty ;
        rdfs:label "HQ location"@en ;
        rdfs:comment "Headquarters city / country"@en ;
        rdfs:domain ic:FundManager ;
        rdfs:range xsd:string .

    ic:investorName a owl:DatatypeProperty ;
        rdfs:label "investor name"@en ;
        rdfs:comment "Full legal name or entity name"@en ;
        rdfs:domain ic:Investor ;
        rdfs:range xsd:string .

    ic:investorType a owl:DatatypeProperty ;
        rdfs:label "investor type"@en ;
        rdfs:comment "INDIVIDUAL|TRUST|IRA|CORPORATION|FOUNDATION|PARTNERSHIP|LLC"@en ;
        rdfs:domain ic:Investor ;
        rdfs:range xsd:string .

    ic:ipAddress a owl:DatatypeProperty ;
        rdfs:label "IP address"@en ;
