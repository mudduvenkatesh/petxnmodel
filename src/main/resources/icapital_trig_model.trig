    ic:isRecallable a owl:DatatypeProperty ;
        rdfs:label "is recallable"@en ;
        rdfs:comment "Whether capital may be recalled"@en ;
        rdfs:domain ic:CapitalCall ;
        rdfs:range xsd:boolean .

    ic:issuedByFund a owl:ObjectProperty ;
        rdfs:label "issued by fund"@en ;
