        rdfs:range xsd:decimal .

    ic:isActive a owl:DatatypeProperty ;
        rdfs:label "is active"@en ;
        rdfs:comment "Active status flag"@en ;
        rdfs:domain ic:Advisor ;
        rdfs:range xsd:boolean .

    ic:isExecuted a owl:DatatypeProperty ;
        rdfs:label "is executed"@en ;
