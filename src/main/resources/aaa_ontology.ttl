    rdfs:label "investor type"@en ;
    rdfs:comment "INSURANCE_CO|PENSION|ENDOWMENT|FAMILY_OFFICE|INDIVIDUAL|SOVEREIGN_WEALTH"@en ;
    rdfs:domain aaa:Investor ;
    rdfs:range xsd:string .

