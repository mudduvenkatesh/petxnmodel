@prefix aaa: <https://ontology.apollo.com/aaa/> .
@prefix ape: <https://ontology.apollo.com/aaa/pe/> .
@prefix asc: <https://ontology.apollo.com/aaa/sc/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aaa:accreditationStatus a owl:DatatypeProperty ;
    rdfs:label "accreditation status"@en ;
    rdfs:comment "ACCREDITED|QUALIFIED_PURCHASER|INSTITUTIONAL"@en ;
    rdfs:domain aaa:Investor ;
    rdfs:range xsd:string .

aaa:auditAction a owl:DatatypeProperty ;
    rdfs:label "action"@en ;
    rdfs:comment "CREATE|UPDATE|DELETE|STATUS_CHANGE|APPROVE"@en ;
    rdfs:domain aaa:AuditLog ;
    rdfs:range xsd:string .

aaa:auditEntityId a owl:DatatypeProperty ;
    rdfs:label "audited entity ID"@en ;
    rdfs:comment "ID of the mutated entity"@en ;
    rdfs:domain aaa:AuditLog ;
    rdfs:range xsd:string .

aaa:auditEntityType a owl:DatatypeProperty ;
    rdfs:label "entity type"@en ;
    rdfs:comment "Class of mutated entity"@en ;
    rdfs:domain aaa:AuditLog ;
    rdfs:range xsd:string .

aaa:auditOf a owl:ObjectProperty ;
    rdfs:label "audit of"@en ;
    rdfs:comment "Audit log entry for entity"@en ;
    rdfs:domain aaa:AuditLog ;
    rdfs:range aaa:AAAEntity .

aaa:auditTimestamp a owl:DatatypeProperty ;
    rdfs:label "timestamp"@en ;
    rdfs:comment "Event timestamp (UTC, immutable)"@en ;
    rdfs:domain aaa:AuditLog ;
    rdfs:range xsd:dateTime .

aaa:callAmount a owl:DatatypeProperty ;
    rdfs:label "call amount"@en ;
    rdfs:comment "Dollar amount called"@en ;
    rdfs:domain aaa:CapitalCall ;
    rdfs:range xsd:decimal .

aaa:callDate a owl:DatatypeProperty ;
    rdfs:label "call date"@en ;
    rdfs:comment "Date notice was issued"@en ;
    rdfs:domain aaa:CapitalCall ;
    rdfs:range xsd:date .

aaa:callId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "call ID"@en ;
    rdfs:comment "Unique call notice ID"@en ;
    rdfs:domain aaa:CapitalCall ;
    rdfs:range xsd:string .

aaa:callNumber a owl:DatatypeProperty ;
    rdfs:label "call number"@en ;
    rdfs:comment "Sequential call number"@en ;
    rdfs:domain aaa:CapitalCall ;
    rdfs:range xsd:integer .

aaa:callPercentage a owl:DatatypeProperty ;
    rdfs:label "call percentage"@en ;
    rdfs:comment "Percentage of commitment called"@en ;
