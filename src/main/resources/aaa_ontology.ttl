aaa:Fund a owl:Class ;
    rdfs:label "Fund"@en ;
    rdfs:comment "Any AAA fund vehicle (PE or SC)"@en ;
    rdfs:subClassOf aaa:AAAEntity .

asc:SecurityHolding a owl:Class ;
    rdfs:label "Security Holding"@en ;
    rdfs:comment "Position in a specific ABS/CLO security"@en ;
    rdfs:subClassOf aaa:AAAEntity .

aaa:Transaction a owl:Class ;
    rdfs:label "Transaction"@en ;
    rdfs:comment "Any financial event in an AAA fund"@en ;
    rdfs:subClassOf aaa:AAAEntity .

aaa:AAAEntity a owl:Class ;
    rdfs:label "AAA Entity"@en ;
    rdfs:comment "Abstract root for all AAA fund entities"@en .

