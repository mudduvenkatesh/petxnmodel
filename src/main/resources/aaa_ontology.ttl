aaa:ontology a owl:Ontology ;
    rdfs:label "Apollo AAA Dual-Fund Ontology"@en ;
    dcterms:created "2024-01-01"^^xsd:date ;
    dcterms:publisher "Apollo Global Management" ;
    rdfs:comment "OWL ontology covering both Apollo Aligned Alternatives (private equity feeder) and Athene AAA Structured Credit (fixed-income / insurance ABS) fund families. Shares common transaction and participant vocabulary; extends with fund-specific asset, tranche, and credit-quality concepts."@en ;
    owl:versionIRI <https://ontology.apollo.com/aaa/ontology/1.0> .

aaa:ownsAccount a owl:ObjectProperty ;
    rdfs:label "owns account"@en ;
    rdfs:comment "Investor owns account"@en ;
    rdfs:domain aaa:Investor ;
    rdfs:range aaa:Account .

ape:ManagementFeeInvoice a owl:Class ;
    rdfs:label "Management Fee Invoice"@en ;
    rdfs:comment "Quarterly management fee invoice"@en ;
    rdfs:subClassOf aaa:FeeRecord .

ape:Redemption a owl:Class ;
    rdfs:label "PE Redemption"@en ;
    rdfs:comment "LP redemption / withdrawal from the fund"@en ;
    rdfs:subClassOf aaa:Transaction .

ape:Subscription a owl:Class ;
    rdfs:label "PE Subscription"@en ;
    rdfs:comment "LP subscription / admission event"@en ;
    rdfs:subClassOf aaa:Transaction .

ape:calledAmount a owl:DatatypeProperty ;
    rdfs:label "called amount"@en ;
    rdfs:comment "Capital called to date"@en ;
    rdfs:domain ape:Commitment ;
    rdfs:range xsd:decimal .

ape:carryAmount a owl:DatatypeProperty ;
    rdfs:label "carry amount"@en ;
    rdfs:comment "Total carry paid to GP"@en ;
