    rdfs:label "due date"@en ;
    rdfs:comment "Payment due date"@en ;
    rdfs:domain aaa:CapitalCall ;
    rdfs:range xsd:date .

aaa:entityId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "entity ID"@en ;
    rdfs:comment "Unique entity UUID"@en ;
    rdfs:domain aaa:AAAEntity ;
    rdfs:range xsd:string .

aaa:feeAmount a owl:DatatypeProperty ;
    rdfs:label "fee amount"@en ;
    rdfs:comment "Calculated fee amount"@en ;
